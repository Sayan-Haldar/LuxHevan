<% layout("/layouts/boilerplate") %>
    <link rel="stylesheet" href="/css/filter.css">
    
    <section class="stay-search">
        <h1>Find your next stay</h1>
        <p>Search homes, then reserve dates, guests, and a live total on the stay page.</p>
        
        <!-- Quick Search Form -->
        <form action="/listings/search" method="get" class="stay-search-bar-form mt-3 mb-3">
            <div class="input-group stay-hero-search shadow-sm" style="border-radius: 999px; overflow: hidden; border: 1px solid #ddd;">
                <span class="input-group-text bg-white border-0 ps-3"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="search" class="form-control border-0 shadow-none ps-2 py-2" name="q" placeholder="Search by city, country, stay title, or category (e.g. Bali, Beachfront, Aspen)..." value="<%= typeof searchQuery !== 'undefined' && searchQuery ? searchQuery : '' %>">
                <button class="btn btn-danger px-4" type="submit" style="background-color: #fe424d; border-color: #fe424d; font-weight: 600;">Search</button>
            </div>
        </form>

        <div class="stay-pills">
            <a href="/listings/filter/Beachfront" class="stay-pill text-decoration-none">🏖️ Beachfront</a>
            <a href="/listings/filter/Villas" class="stay-pill text-decoration-none">🏡 Villas</a>
            <a href="/listings/filter/Iconic%20Cities" class="stay-pill text-decoration-none">🏙️ Iconic Cities</a>
            <a href="/listings/filter/Mountains" class="stay-pill text-decoration-none">⛰️ Mountains</a>
            <a href="/listings/filter/Amazing%20Pools" class="stay-pill text-decoration-none">🏊 Amazing Pools</a>
            <a href="/listings/filter/Luxe" class="stay-pill text-decoration-none">✨ Luxe</a>
        </div>
    </section>

    <% 
        const activeCat = (typeof filterCategory !== 'undefined' && filterCategory) ? filterCategory.toLowerCase() : '';
    %>
    <div class="filters-main">
        <div id="filters">
            <button type="button" class="slide-btn left_img_button" id="slideLeftBtn" style="display: none;" aria-label="Scroll left">
                <i class="fa-solid fa-angle-left"></i>
            </button>
            
            <a href="/listings">
                <div class="filter ALL ps-2 pe-2 <%= !activeCat ? 'selectedFilter' : '' %>">
                    <div><img src="/Icon/0.png" alt="icon" style="width: 25px; height: 25px;"></div>
                    <p style="text-decoration: none;">ALL</p>
                </div>
            </a>
            
            <a href="/listings/filter/Beachfront">
                <div class="filter Beachfront <%= activeCat === 'beachfront' ? 'selectedFilter' : '' %>">
                    <div><img src="/Icon/1.png" alt="icon" style="width: 25px; height: 25px;"></div>
                    <p>Beachfront</p>
                </div>
            </a>
            
            <a href="/listings/filter/Cabins">
                <div class="filter Cabins <%= activeCat === 'cabins' ? 'selectedFilter' : '' %>">
                    <div><img src="/Icon/2.png" alt="icon" style="width: 25px; height: 25px;"></div>
                    <p>Cabins</p>
                </div>
            </a>
            
            <a href="/listings/filter/Villas">
                <div class="filter Villas <%= activeCat === 'villas' ? 'selectedFilter' : '' %>">
                    <div><i class="fa-solid fa-house-chimney-window" style="font-size: 22px; color: #444; line-height: 25px;"></i></div>
                    <p>Villas</p>
                </div>
            </a>
            
            <a href="/listings/filter/Iconic%20Cities">
                <div class="filter Iconic-cities <%= activeCat === 'iconic cities' ? 'selectedFilter' : '' %>">
                    <div><img src="/Icon/21.png" alt="icon" style="width: 25px; height: 25px;"></div>
                    <p>Iconic cities</p>
                </div>
            </a>
            
            <a href="/listings/filter/Mountains">
                <div class="filter Mountains <%= activeCat === 'mountains' ? 'selectedFilter' : '' %>">
                    <div><i class="fa-solid fa-mountain" style="font-size: 22px; color: #444; line-height: 25px;"></i></div>
                    <p>Mountains</p>
                </div>
            </a>
            
            <a href="/listings/filter/Lakefront">
                <div class="filter Lakefront <%= activeCat === 'lakefront' ? 'selectedFilter' : '' %>">
                    <div><img src="/Icon/4.png" alt="icon" style="width: 25px; height: 25px;"></div>
                    <p>Lakefront</p>
                </div>
            </a>
            
            <a href="/listings/filter/Amazing%20Pools">
                <div class="filter Amazing-pools <%= activeCat === 'amazing pools' ? 'selectedFilter' : '' %>">
                    <div><img src="/Icon/6.png" alt="icon" style="width: 25px; height: 25px;"></div>
                    <p>Amazing pools</p>
                </div>
            </a>
            
            <a href="/listings/filter/Countryside">
                <div class="filter Countryside <%= activeCat === 'countryside' ? 'selectedFilter' : '' %>">
                    <div><img src="/Icon/12.png" alt="icon" style="width: 25px; height: 25px;"></div>
                    <p>Countryside</p>
                </div>
            </a>
            
            <a href="/listings/filter/Tropical">
                <div class="filter Tropical <%= activeCat === 'tropical' ? 'selectedFilter' : '' %>">
                    <div><img src="/Icon/15.png" alt="icon" style="width: 25px; height: 25px;"></div>
                    <p>Tropical</p>
                </div>
            </a>
            
            <a href="/listings/filter/Treehouses">
                <div class="filter Treehouse <%= activeCat === 'treehouses' ? 'selectedFilter' : '' %>">
                    <div><img src="/Icon/13.png" alt="icon" style="width: 25px; height: 25px;"></div>
                    <p>Treehouses</p>
                </div>
            </a>
            
            <a href="/listings/filter/Luxe">
                <div class="filter Luxe <%= activeCat === 'luxe' ? 'selectedFilter' : '' %>">
                    <div><img src="/Icon/20.png" alt="icon" style="width: 25px; height: 25px;"></div>
                    <p>Luxe</p>
                </div>
            </a>
            
            <a href="/listings/filter/Rooms">
                <div class="filter Rooms <%= activeCat === 'rooms' ? 'selectedFilter' : '' %>">
                    <div><img src="/Icon/9.png" alt="icon" style="width: 25px; height: 25px;"></div>
                    <p>Rooms</p>
                </div>
            </a>
            
            <a href="/listings/filter/Historic">
                <div class="filter Historic <%= activeCat === 'historic' ? 'selectedFilter' : '' %>">
                    <div><img src="/Icon/17.png" alt="icon" style="width: 25px; height: 25px;"></div>
                    <p>Historic</p>
                </div>
            </a>
            
            <a href="/listings/filter/National%20Parks">
                <div class="filter National-parks <%= activeCat === 'national parks' ? 'selectedFilter' : '' %>">
                    <div><img src="/Icon/16.png" alt="icon" style="width: 25px; height: 25px;"></div>
                    <p>National parks</p>
                </div>
            </a>
            
            <button type="button" class="slide-btn right_img_button" id="slideRightBtn" aria-label="Scroll right">
                <i class="fa-solid fa-angle-right"></i>
            </button>
        </div>
        
        <div class="tax-toggle tax-filter-icon filterIcon me-2 ms-2 " onclick="filterClick()">
            <div class="form-check form-switch form-check-reverse pe-1" style="cursor: pointer;">
                <i class="fa-solid fa-sliders" id="filter-icon"></i>
                <label class="form-check-label" for="filter-icon" style="cursor: pointer;">Filters</label>
            </div>
        </div>
        <div class="tax-toggle tax-filter-icon-small filterIcon me-2 ms-2 " onclick="filterClick()">
            <div class="form-check form-switch form-check-reverse pe-0">
                <i class="fa-solid fa-sliders ps-1" id="filter-icon" style="cursor: pointer;"></i>
            </div>
        </div>
        <div class="tax-toggle tax-filter ">
            <div class="form-check form-switch form-check-reverse" >
                <input class="form-check-input tax-switch shadow-none" type="checkbox" role="switch" id="flexSwitchCheckDefault" style="cursor: pointer;">
                <label class="form-check-label changeAfter" for="flexSwitchCheckDefault" style="cursor: pointer; margin-top: 3px;">Display total before taxes</label>
            </div>
        </div>
    </div>
    
    <div class="tax-toggle tax-sticky">
        <div class="form-check form-switch form-check-reverse">
            <input class="form-check-input tax-switch tax-sticky-sticky shadow-none" type="checkbox" role="switch" id="flexSwitchCheckDefaultS" style="cursor: pointer;">
            <label class="form-check-label changeAfter" for="flexSwitchCheckDefaultS" style="cursor: pointer;">Display total before taxes</label>
        </div>
    </div>
    
    <div class="row row-cols-xxl-4 row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-1">
        <% if (allListing.length === 0) { %>
            <div class="col-12 text-center my-5 py-5">
                <div style="font-size: 3rem; margin-bottom: 0.75rem;">🔍</div>
                <h3>No Stays Found</h3>
                <p class="text-muted">
                    <% if (typeof filterCategory !== 'undefined' && filterCategory) { %>
                        No stays match the category "<%= filterCategory %>".
                    <% } else if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                        No stays found matching "<%= searchQuery %>".
                    <% } else { %>
                        No listings match your search or filters.
                    <% } %>
                    Try exploring other categories or clearing your search filters.
                </p>
                <a href="/listings" class="btn btn-outline-dark mt-2">Explore All Stays</a>
            </div>
        <% } %>
        
        <% for (const listing of allListing) { %>
            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card col listing-card index-res">
                    <div class="index-res-img">
                        <div class="card-img">
                            <img class="heart heart-r" src="/Icon/heart-red.png" alt="like" style="opacity: 1; z-index: 5;">
                            <img class="heart heart-b" src="/Icon/heart-black.png" alt="like" style="z-index: 6;">
                            <img src="<%= listing.image && listing.image.url ? listing.image.url : '/Icon/0.png' %>" class="card-img-top" alt="listing_image" />
                        </div>
                        <%
                        let day = Math.floor(Math.random() * 4 + 2);
                        let no = Math.floor(Math.random() * 28 + 1);
                        let date = (new Date('2023-11-01')).getDate() + no;
                        let dateA = (new Date('2023-11-01')).getDate() + no + day;
                        let month = Date().split(" ")[1];
                        %>
                        <div class="card-body mt-1 ms-2">
                            <p class="card-text" style="display: block;">
                                <b><%= listing.title %></b> <br>
                                <span>&nbsp;<%= listing.location %>, <%= listing.country %></span>
                                <span style="display: block;"><span class="tax-info">&nbsp;<%= day %> nights •</span> &nbsp;<%= date %>-<%- dateA %> &nbsp;&nbsp;<%= month %></span>
                                <span class="price-info"><span class=" fw-bold">&nbsp;&#8377;<%= listing.price.toLocaleString("en-IN") %> </span>  night</span>
                                <span class="book-now-chip">Reserve</span>
                                <i class="tax-info tax-underline ms-1"><i class="rs-sign"><b> &#8377;</i><%= (listing.price*1.18).toLocaleString("en-In") %></b> &nbsp;total after taxes</i>
                            </p>
                        </div>
                    </div>
                </div>
            </a>
        <% } %>
    </div>

<script defer src="/js/filter.js"></script>
