<link rel="stylesheet" href="/css/show.css">
<link rel="stylesheet" href="/css/delete-confirm.css">
<link rel="stylesheet" href="/css/button-style.css">
<% layout("/layouts/boilerplate") %>
<style>
    @media (max-width:768px) {
        .alert{
            left: 17%;
        }
    }
</style>
<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    // const listing = <%#- JSON.stringify(listing) %>;
    const listing = JSON.parse(`<%- JSON.stringify(listing) %>`);
</script>
    <div class="row mt-3 show-main">
        <div class="show-body">
            <div class="stay-layout">
                <div>
                    <h3><%= listing.title %></h3>
                    <p class="stay-meta"><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p>
                    <div class="stay-photo">
                        <img src="<%= listing.image && listing.image.url ? listing.image.url : '/Icon/error-img.jpg' %>" alt="<%= listing.title %>">
                    </div>
                    <div class="stay-facts">
                        <p><b>Hosted by</b> @<%= listing.owner && listing.owner.username ? listing.owner.username : 'LuxHaven Host' %></p>
                        <p><%= listing.description %></p>
                        <p><b>Category:</b> <%= (listing.category && Array.isArray(listing.category) ? listing.category.join(", ") : (listing.category || "General")) %></p>
                    </div>
                </div>
                <aside class="reserve-card" data-booking data-price="<%= listing.price %>">
                    <div class="reserve-price">&#8377;<%= listing.price.toLocaleString("en-IN") %> <span>/ night</span></div>
                    <form method="post" action="/listings/<%= listing._id %>/book">
                        <div class="reserve-grid">
                            <div class="reserve-field">
                                <label for="checkIn">Check-in</label>
                                <input type="date" id="checkIn" name="checkIn" required>
                            </div>
                            <div class="reserve-field">
                                <label for="checkOut">Checkout</label>
                                <input type="date" id="checkOut" name="checkOut" required>
                            </div>
                            <div class="reserve-field reserve-guests">
                                <label for="guests">Guests</label>
                                <select id="guests" name="guests">
                                    <% for (let guest = 1; guest <= 16; guest++) { %>
                                        <option value="<%= guest %>"><%= guest %> guest<%= guest > 1 ? "s" : "" %></option>
                                    <% } %>
                                </select>
                            </div>
                        </div>
                        <% if (currUser) { %>
                            <button class="reserve-btn" type="submit">Reserve</button>
                        <% } else { %>
                            <a class="reserve-btn d-block text-center text-decoration-none" href="/login">Log in to reserve</a>
                        <% } %>
                    </form>
                    <p class="reserve-note">You will not be charged yet. Totals update as dates change.</p>
                    <div class="reserve-lines">
                        <div><span data-nights>Select dates</span><span data-stay>—</span></div>
                        <div><span>Service fee</span><span data-fee>—</span></div>
                        <div><span>Taxes</span><span data-tax>—</span></div>
                    </div>
                    <div class="reserve-total"><span>Total</span><span data-total>—</span></div>
                </aside>
            </div>
            <script src="/js/booking.js"></script>
            <!-- Authorization  -->
            <% if(currUser && currUser._id.equals(listing.owner._id)){ %>
            <div class="btns offset-2 ">
                <div class="btns-edit">
                    <a type="button" href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn styleBtn">Edit</a>
                    <form method="post" action="/listings/<%= listing._id %>?_method=DELETE" class="needs-validation">
                        <button type="reset" class="btn btn-danger offset-4 del-btn styleBtn" id="delete-confirm">Delete</button>
                        <div class="fnx-fixed-dis">
                            <div class="delete-fnx" style="display: none;">
                                <p>I want to delete this listings.</p>
                                <p>"<%= listing.title %>"</p>
                                <div class="conf cancle-confirm">Cancel</div>
                                <button class="conf delete-confirm">Confirm</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <% } %>
            <!-- --------------- review ------------- -->
            <hr class="mt-2">
            <div class="col-8 offset-2">
                <% if(currUser){ %>
                <p><b>Leave a Review &nbsp;<i class="fa-regular fa-pen-to-square"></i></b></p>
                <form method="post" action="/listings/<%= listing._id %>/reviews" class="needs-validation" novalidate>
                    <div class="mt-3 star-rating-wrapper">
                        <label class="star-rating-label" for="rating">Rating</label>
                        <div class="star-rating">
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" checked />
                            <label for="first-rate5" title="5 stars - Amazing"><i class="fa-solid fa-star"></i></label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="4 stars - Very good"><i class="fa-solid fa-star"></i></label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="3 stars - Average"><i class="fa-solid fa-star"></i></label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="2 stars - Not good"><i class="fa-solid fa-star"></i></label>
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="1 star - Terrible"><i class="fa-solid fa-star"></i></label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="comment">Comment</label>
                        <textarea class="form-control" name="review[comment]" id="comment" cols="30" rows="3" placeholder="Share your experience here..." required></textarea>
                        <div class="invalid-feedback">Please add some comments for review</div>
                    </div>
                    <button class="btn btn-success mb-3 styleBtn">Submit</button>
                </form>
                <% } %>
                <% if(listing.reviews && listing.reviews.length > 0 ){ %>
                <p><b>All Reviews (<%= listing.reviews.length %>)</b></p>
                <div class="row m-1 review-main">
                    <% for (const review of listing.reviews) { %>
                        <div class="card col-xs-4 col-sm-12 col-md-12 col-lg-5 review-lg">
                            <div class="card-body mb-2 review-card">
                                <div class="review-stars mb-2" title="<%= review.rating %> out of 5 stars">
                                    <% for(let i = 1; i <= 5; i++) { %>
                                        <i class="<%= i <= review.rating ? 'fa-solid' : 'fa-regular' %> fa-star"></i>
                                    <% } %>
                                    <span class="rating-num">(<%= review.rating %>/5)</span>
                                </div>
                                <span style="max-width: 80vw;">
                                    <h5 class="card-title">@<%= review.author ? review.author.username : 'Guest' %> &nbsp; :</h5>
                                    <p class="card-text mb-1 review-comment"><%= review.comment %></p>
                                </span>
                            </div>
                            <% if(currUser && review.author && (currUser._id.equals ? currUser._id.equals(review.author._id) : currUser._id.toString() === review.author._id.toString())){ %>
                            <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mb-1 review-del needs-validation" method="post">
                                <button class="btn btn-sm btn-danger" title="Delete Review"><i class="fa-solid fa-trash"></i></button>
                            </form>
                            <% } %>
                        </div>
                    <% } %>
                </div>
                <% } %>
            </div>
            <!-- Load the `mapbox-gl-geocoder` plugin. -->
            <script src="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-geocoder/v5.0.0/mapbox-gl-geocoder.min.js"></script>
            <link rel="stylesheet" href="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-geocoder/v5.0.0/mapbox-gl-geocoder.css" type="text/css">
            <div class="col-8 offset-2 mapImg">
                <p><b>Where you'll be &nbsp;<i class="fa-solid fa-location-crosshairs"></i></p></b>
                <div id="map" style="position: relative;">
                    <div class="map-zoom-icon">
                        <div class="icon icon-plus" onclick="zoomin()"><i class="fa-solid fa-magnifying-glass-plus"></i></div>
                        <div class="icon icon-min" onclick="zoomout()"><i class="fa-solid fa-magnifying-glass-minus"></i></div>
                    </div>
                    <div class="akash"><a href="https://github.com/sayanhaldar0010">SH GitHub</a></div>
                </div>
            </div>
        </div>
    </div>
<script src="/js/map.js"></script>
<script src="/js/delete-confirm.js"></script>

