<link rel="stylesheet" href="/css/filterbtn.css">

<div class="main filter-modal-card">
    <!-- Modal Header -->
    <div class="filter-modal-header">
        <button type="button" class="filter-close-btn" onclick="closefilter()" aria-label="Close filters">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h2>Filters</h2>
        <div style="width: 34px;"></div> <!-- Spacer for perfect centering -->
    </div>

    <!-- Filter Form -->
    <form action="/listings/search" method="GET" id="filterModalForm" style="display: flex; flex-direction: column; flex-grow: 1; overflow: hidden; margin: 0;">
        <div class="filter-modal-body">
            
            <!-- 1. Destination / Stay Search -->
            <div class="filter-section">
                <div class="filter-section-title">Where to?</div>
                <div class="filter-section-subtitle">Search by city, country, or stay name</div>
                <div class="input-group" style="border-radius: 12px; overflow: hidden; border: 1px solid #b0b0b0;">
                    <span class="input-group-text bg-white border-0 ps-3"><i class="fa-solid fa-location-dot text-muted"></i></span>
                    <input type="text" class="form-control border-0 shadow-none ps-2 py-2" name="q" id="filterModalQuery" placeholder="e.g. Malibu, Aspen, Bali, Italy..." value="<%= typeof searchQuery !== 'undefined' && searchQuery ? searchQuery : '' %>">
                </div>
            </div>

            <!-- 2. Relatable Categories -->
            <div class="filter-section">
                <div class="filter-section-title">Property Category</div>
                <div class="filter-section-subtitle">Find the exact experience you want</div>
                
                <% 
                    const currentCat = typeof filterCategory !== 'undefined' && filterCategory ? filterCategory.toLowerCase() : '';
                    const categoriesList = [
                        { name: "All Categories", val: "" },
                        { name: "Beachfront", val: "Beachfront" },
                        { name: "Cabins", val: "Cabins" },
                        { name: "Villas", val: "Villas" },
                        { name: "Iconic Cities", val: "Iconic Cities" },
                        { name: "Mountains", val: "Mountains" },
                        { name: "Lakefront", val: "Lakefront" },
                        { name: "Amazing Pools", val: "Amazing Pools" },
                        { name: "Countryside", val: "Countryside" },
                        { name: "Tropical", val: "Tropical" },
                        { name: "Treehouses", val: "Treehouses" },
                        { name: "Luxe", val: "Luxe" },
                        { name: "Rooms", val: "Rooms" },
                        { name: "Historic", val: "Historic" },
                        { name: "National Parks", val: "National Parks" }
                    ];
                %>
                
                <div class="filter-chip-group">
                    <% categoriesList.forEach((c, idx) => { %>
                        <% const isChecked = (c.val === '' && !currentCat) || (c.val.toLowerCase() === currentCat); %>
                        <input type="radio" name="category" value="<%= c.val %>" class="filter-chip-radio" id="mcat-<%= idx %>" <%= isChecked ? 'checked' : '' %>>
                        <label class="filter-chip-label" for="mcat-<%= idx %>">
                            <% if (c.val === 'Beachfront') { %>🏖️<% } %>
                            <% if (c.val === 'Cabins') { %>🪵<% } %>
                            <% if (c.val === 'Villas') { %>🏡<% } %>
                            <% if (c.val === 'Iconic Cities') { %>🏙️<% } %>
                            <% if (c.val === 'Mountains') { %>⛰️<% } %>
                            <% if (c.val === 'Lakefront') { %>🌊<% } %>
                            <% if (c.val === 'Amazing Pools') { %>🏊<% } %>
                            <% if (c.val === 'Countryside') { %>🌾<% } %>
                            <% if (c.val === 'Tropical') { %>🌴<% } %>
                            <% if (c.val === 'Treehouses') { %>🌲<% } %>
                            <% if (c.val === 'Luxe') { %>✨<% } %>
                            <% if (c.val === 'Rooms') { %>🛏️<% } %>
                            <% if (c.val === 'Historic') { %>🏰<% } %>
                            <% if (c.val === 'National Parks') { %>🏞️<% } %>
                            <%= c.name %>
                        </label>
                    <% }); %>
                </div>
            </div>

            <!-- 3. Price Range -->
            <div class="filter-section">
                <div class="filter-section-title">Price Range (per night)</div>
                <div class="filter-section-subtitle">Nightly prices before taxes and fees</div>

                <div class="price-input-row">
                    <div class="price-input-card">
                        <span class="price-input-label">Minimum</span>
                        <div class="price-input-field">
                            <span>₹</span>
                            <input type="number" name="minPrice" id="filterMinPrice" placeholder="500" min="0" value="<%= typeof minPrice !== 'undefined' && minPrice ? minPrice : '' %>">
                        </div>
                    </div>
                    <div class="price-input-card">
                        <span class="price-input-label">Maximum</span>
                        <div class="price-input-field">
                            <span>₹</span>
                            <input type="number" name="maxPrice" id="filterMaxPrice" placeholder="100,000" min="0" value="<%= typeof maxPrice !== 'undefined' && maxPrice ? maxPrice : '' %>">
                        </div>
                    </div>
                </div>

                <!-- Quick Presets -->
                <div class="price-presets">
                    <span class="text-muted small align-self-center me-1">Quick Select:</span>
                    <button type="button" class="price-preset-btn" onclick="setPriceRange(0, 25000)">Under ₹25k</button>
                    <button type="button" class="price-preset-btn" onclick="setPriceRange(25000, 60000)">₹25k – ₹60k</button>
                    <button type="button" class="price-preset-btn" onclick="setPriceRange(60000, 150000)">₹60k+</button>
                    <button type="button" class="price-preset-btn" onclick="setPriceRange('', '')">Reset Price</button>
                </div>
            </div>

        </div>

        <!-- Sticky Footer -->
        <div class="filter-modal-footer">
            <button type="button" class="filter-clear-btn" onclick="clearAllModalFilters()">Clear all</button>
            <button type="submit" class="filter-submit-btn">Show Stays</button>
        </div>
    </form>
</div>

<script src="/js/filterIcon.js"></script>
