<link rel="stylesheet" href="/css/filterbtn.css">
<div class="main">
    <header class="nav fixed-top">
        <div>
            <span class="close">
                <svg xmlns="http://www.w3.org/2000/svg" onclick="closefilter()" height="1em" viewBox="0 0 384 512" style="cursor: pointer;">
                    <path
                        d="M342.6 150.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192 210.7 86.6 105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L146.7 256 41.4 361.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 301.3 297.4 406.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.3 256 342.6 150.6z" />
                </svg>
            </span>
            <h1 style="font-size: 1.35rem; font-weight: 700; margin: 0;">Filters</h1>
        </div>
    </header>

    <form action="/listings/search" method="GET" id="filterModalForm">
        <div class="container-btn" style="padding-top: 70px; padding-bottom: 90px;">
            <div>
                <!-- 1. Search Destination / Keyword -->
                <section class="mb-4">
                    <div>
                        <h2 class="h-tag" style="font-size: 1.15rem; font-weight: 600;">Destination or Stay Name</h2>
                        <div class="text text-muted mb-2">Search by city, country, title, or landmark</div>
                        <input type="text" name="q" class="form-control py-2 shadow-none" placeholder="e.g. Malibu, Aspen, Bali, Italy..." value="<%= typeof searchQuery !== 'undefined' && searchQuery ? searchQuery : '' %>">
                    </div>
                </section>

                <hr>

                <!-- 2. Relatable Categories -->
                <section class="mb-4">
                    <div>
                        <h2 class="h-tag" style="font-size: 1.15rem; font-weight: 600;">Property Category</h2>
                        <div class="text text-muted mb-3">Choose a relatable stay style</div>
                        
                        <% 
                            const modalActiveCat = typeof filterCategory !== 'undefined' && filterCategory ? filterCategory : '';
                            const modalCategories = [
                                "All", "Beachfront", "Cabins", "Villas", "Iconic Cities", 
                                "Mountains", "Lakefront", "Amazing Pools", "Countryside", 
                                "Tropical", "Treehouses", "Luxe", "Rooms", "Historic", "National Parks"
                            ];
                        %>
                        <div class="d-flex flex-wrap gap-2">
                            <% for (const cat of modalCategories) { %>
                                <label class="btn btn-outline-dark btn-sm rounded-pill px-3 py-2" style="cursor: pointer;">
                                    <input type="radio" name="category" value="<%= cat === 'All' ? '' : cat %>" class="btn-check" <%= (cat === modalActiveCat || (cat === 'All' && !modalActiveCat)) ? 'checked' : '' %>>
                                    <%= cat %>
                                </label>
                            <% } %>
                        </div>
                    </div>
                </section>

                <hr>

                <!-- 3. Price Range -->
                <section class="mb-4">
                    <div>
                        <h2 class="h-tag" style="font-size: 1.15rem; font-weight: 600;">Price range</h2>
                        <div class="text text-muted mb-2">Nightly prices in INR (&#8377;)</div>
                    </div>
                    <div class="price-range mt-2 d-flex gap-3">
                        <div class="flex-grow-1">
                            <label class="form-label text-muted small mb-1">Minimum Price</label>
                            <div class="input-group">
                                <span class="input-group-text">&#8377;</span>
                                <input type="number" class="form-control shadow-none" name="minPrice" placeholder="500" min="0" value="<%= typeof minPrice !== 'undefined' && minPrice ? minPrice : '' %>">
                            </div>
                        </div>
                        <div class="flex-grow-1">
                            <label class="form-label text-muted small mb-1">Maximum Price</label>
                            <div class="input-group">
                                <span class="input-group-text">&#8377;</span>
                                <input type="number" class="form-control shadow-none" name="maxPrice" placeholder="100000" min="0" value="<%= typeof maxPrice !== 'undefined' && maxPrice ? maxPrice : '' %>">
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <footer class="nav fixed-bottom" style="background: #ffffff; border-top: 1px solid #e0e0e0; z-index: 1060;">
            <div class="d-flex justify-content-between align-items-center w-100 px-4">
                <a href="/listings" class="btn btn-link text-dark text-decoration-underline p-0">Clear all</a>
                <button type="submit" class="btn btn-danger px-4 py-2" style="background-color: #fe424d; border-color: #fe424d; border-radius: 8px; font-weight: 600;">Show Stays</button>
            </div>
        </footer>
    </form>
</div>
<script src="/js/filterIcon.js"></script>
